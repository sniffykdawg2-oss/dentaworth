rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isImage() {
      return request.resource.contentType.matches("image/.*");
    }

    match /practice-assets/{practiceId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && request.resource.size < 5 * 1024 * 1024;
    }

    match /guide-assets/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && request.resource.size < 5 * 1024 * 1024;
    }

    match /private-review/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
