import wixData from 'wix-data';

export async function generateMonthlyAnalytics() {
    // 1. Fetch raw data from your form collection
    const { items } = await wixData.query("SelfReportedProcedurePrices").find();
    
    if (items.length === 0) return "No data to process.";

    // 2. The 10 procedures you are tracking
    const procedures = [
        "exam", "cleaning", "xRays", "extraction", "crown", 
        "rootCanal", "filling", "implant", "whitening", "invisalign"
    ];

    const today = new Date();

    // 3. Process each procedure
    for (const procKey of procedures) {
        // Filter out empty or zero values for this specific procedure
        const validValues = items
            .map(item => Number(item[procKey]))
            .filter(val => !isNaN(val) && val > 0);

        if (validValues.length > 0) {
            // Calculate Average
            const avg = validValues.reduce((a, b) => a + b, 0) / validValues.length;
            
            // 4. Save the calculated result to your MonthlyAnalytics collection
            const toInsert = {
                "date": today,
                "procedureName": procKey,
                "averagePrice": Number(avg.toFixed(2)),
                "sampleSize": validValues.length
            };

            await wixData.insert("MonthlyAnalytics", toInsert);
        }
    }
    return "Monthly analytics successfully updated.";
}/************
.web.js file
************

Backend '.web.js' files contain functions that run on the server side and can be called from page code.

Learn more at https://dev.wix.com/docs/develop-websites/articles/coding-with-velo/backend-code/web-modules/calling-backend-code-from-the-frontend

