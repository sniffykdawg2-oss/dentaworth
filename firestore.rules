rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isString(value) {
      return value is string;
    }

    function optionalString(value, maxLength) {
      return value == null || (isString(value) && value.size() <= maxLength);
    }

    function hasOnlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function isPendingCreate() {
      return request.resource.data.status == "pending"
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidSubmissionGuard() {
      return request.resource.data.submissionGuard is map
        && request.resource.data.submissionGuard.keys().hasOnly(["formStartedAt", "website"])
        && request.resource.data.submissionGuard.website == ""
        && request.resource.data.submissionGuard.formStartedAt is timestamp
        && request.resource.data.submissionGuard.formStartedAt < request.time
        && request.resource.data.submissionGuard.formStartedAt > request.time - duration.value(1, "h")
        && request.time > request.resource.data.submissionGuard.formStartedAt + duration.value(3, "s");
    }

    function validProcedurePrices() {
      return request.resource.data.procedurePrices is map
        && request.resource.data.procedurePrices.keys().hasOnly([
          "rootCanal",
          "xray",
          "extraction",
          "crown",
          "cleaning",
          "exam",
          "implant",
          "filling",
          "whitening",
          "invisalign"
        ]);
    }

    function validProcedureKey(value) {
      return value in [
        "rootCanal",
        "xray",
        "extraction",
        "crown",
        "cleaning",
        "exam",
        "implant",
        "filling",
        "whitening",
        "invisalign"
      ];
    }

    function validProfileAdminFlag() {
      return request.resource.data.isAdmin == (request.auth.token.admin == true);
    }

    match /priceReports/{reportId} {
      allow create: if hasOnlyKeys([
          "county",
          "state",
          "providerName",
          "procedurePrices",
          "notes",
          "source",
          "status",
          "submissionGuard",
          "schemaVersion",
          "createdAt",
          "updatedAt"
        ])
        && isPendingCreate()
        && hasValidSubmissionGuard()
        && request.resource.data.source == "self-reporting-form"
        && request.resource.data.state == "Florida"
        && isString(request.resource.data.county)
        && request.resource.data.county.size() > 0
        && optionalString(request.resource.data.providerName, 180)
        && optionalString(request.resource.data.notes, 3000)
        && validProcedurePrices();

      allow read, update, delete: if isAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if hasOnlyKeys([
          "name",
          "email",
          "message",
          "topic",
          "source",
          "status",
          "submissionGuard",
          "schemaVersion",
          "createdAt",
          "updatedAt"
        ])
        && isPendingCreate()
        && hasValidSubmissionGuard()
        && request.resource.data.source in [
          "contact-form",
          "advertising-page",
          "practice-promotion-page"
        ]
        && request.resource.data.topic in [
          "general",
          "correction",
          "advertising",
          "practice-promotion"
        ]
        && isString(request.resource.data.name)
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && isString(request.resource.data.email)
        && request.resource.data.email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$")
        && request.resource.data.email.size() <= 180
        && isString(request.resource.data.message)
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 3000;

      allow read, update, delete: if isAdmin();
    }

    match /newsletterSubscribers/{subscriptionId} {
      allow create: if hasOnlyKeys([
          "email",
          "source",
          "submissionGuard",
          "schemaVersion",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && hasValidSubmissionGuard()
        && request.resource.data.source == "footer-newsletter"
        && isString(request.resource.data.email)
        && request.resource.data.email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$")
        && request.resource.data.email.size() <= 180;

      allow read, update, delete: if isAdmin();
    }

    match /priceRanges/{rangeId} {
      allow read: if isAdmin() || resource.data.status == "published";
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "state",
          "county",
          "procedure",
          "low",
          "high",
          "currency",
          "rating",
          "status",
          "sourceSummary",
          "createdAt",
          "updatedAt",
          "publishedAt",
          "schemaVersion"
        ])
        && request.resource.data.state == "Florida"
        && isString(request.resource.data.county)
        && request.resource.data.county.size() > 0
        && validProcedureKey(request.resource.data.procedure)
        && request.resource.data.low is number
        && request.resource.data.high is number
        && request.resource.data.low >= 0
        && request.resource.data.high >= request.resource.data.low
        && request.resource.data.currency == "USD"
        && request.resource.data.status in ["draft", "published", "archived"]
        && isString(request.resource.data.sourceSummary)
        && request.resource.data.sourceSummary.size() > 0
        && request.resource.data.schemaVersion == 1;
      allow delete: if isAdmin();
    }

    match /dentistProfiles/{profileId} {
      allow read: if isAdmin() || resource.data.status == "published";
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "practiceName",
          "slug",
          "state",
          "county",
          "city",
          "address",
          "zipCode",
          "websiteUrl",
          "phone",
          "email",
          "services",
          "notes",
          "status",
          "createdAt",
          "updatedAt",
          "publishedAt",
          "schemaVersion"
        ])
        && isString(request.resource.data.practiceName)
        && request.resource.data.practiceName.size() > 0
        && request.resource.data.practiceName.size() <= 180
        && isString(request.resource.data.slug)
        && request.resource.data.slug == profileId
        && request.resource.data.state == "Florida"
        && isString(request.resource.data.county)
        && request.resource.data.county.size() > 0
        && optionalString(request.resource.data.city, 120)
        && optionalString(request.resource.data.address, 220)
        && optionalString(request.resource.data.zipCode, 20)
        && optionalString(request.resource.data.websiteUrl, 300)
        && optionalString(request.resource.data.phone, 40)
        && optionalString(request.resource.data.email, 180)
        && optionalString(request.resource.data.notes, 3000)
        && request.resource.data.services is list
        && request.resource.data.services.size() > 0
        && request.resource.data.services.size() <= 10
        && request.resource.data.status in ["draft", "published", "archived"]
        && request.resource.data.schemaVersion == 1;
      allow delete: if isAdmin();
    }

    match /userProfiles/{userId} {
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "isAdmin",
          "lastSignedInAt",
          "updatedAt",
          "schemaVersion"
        ])
        && request.resource.data.schemaVersion == 1
        && validProfileAdminFlag();

      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();

      match /savedOperations/{operationId} {
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            "treatment",
            "county",
            "state",
            "notes",
            "schemaVersion",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.state == "Florida"
          && request.resource.data.treatment in [
            "Cleaning",
            "Exam",
            "X-ray",
            "Filling",
            "Whitening",
            "Extraction",
            "Root canal",
            "Crown, ceramic",
            "Implant",
            "Invisalign"
          ]
          && isString(request.resource.data.county)
          && request.resource.data.county.size() > 0
          && optionalString(request.resource.data.notes, 1000)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow read, delete: if isSignedIn() && request.auth.uid == userId;
        allow update: if false;
      }
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
